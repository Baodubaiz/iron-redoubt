[resource]
script = ExtResource("15_ab4dx")
id = &"level_26"
display_name = "10 — Dynamo"
level_number = 10
map = ExtResource("14_ho5ny")
waves = Array[ExtResource("17_6nvqi")]([SubResource("Resource_nu0jq"), SubResource("Resource_l1kwi"), SubResource("Resource_2hxun"), SubResource("Resource_hrsfm"), SubResource("Resource_jre5a"), SubResource("Resource_lpe6r"), SubResource("Resource_hmqsj"), SubResource("Resource_ijqdc"), SubResource("Resource_bqiwy"), SubResource("Resource_e1sjo"), SubResource("Resource_k0xg2"), SubResource("Resource_aiydn"), SubResource("Resource_ql5hd"), SubResource("Resource_swcv4"), SubResource("Resource_r8g36"), SubResource("Resource_ficw7")])
starting_currency = 500
base_hp = 25
available_towers = Array[ExtResource("1_hmgci")]([ExtResource("2_hnfve"), ExtResource("3_e52d0"), ExtResource("4_xw1h0"), ExtResource("5_rihde"), ExtResource("6_1f5ov"), ExtResource("7_r25rv"), ExtResource("8_rirrm"), ExtResource("9_ncgvs"), ExtResource("10_1jp87"), ExtResource("11_7rgrb"), ExtResource("12_i4a81")])
