extends SceneTree
## Turns tools/level_plan.gd (enemies + threat per wave) into exact counts in tools/level_waves.gd.
## Run:  godot --headless --path . -s res://tools/gen_waves.gd   then   -s res://tools/author_data.gd
## Uses the current data (enemy stats, towers, maps, economy) to know what the player can field per wave.

const LP = preload("res://tools/level_plan.gd")
const CROWD_CAP := 100 ## max enemies spawned in any 25 s window; intervals stretch, counts never drop
## Late levels (2026-11-18, user approved): the lightest enemies (Swarmling 0.36, Dart 0.9, Drone 1 threat)
## ballooned the counts to 1500-3300 enemies per level (lag, visual noise). From LIGHT_LATE_PEAK on, their
## budgeted groups keep only this share of their plan weight; the freed threat goes to the heavier budgeted
## groups of the same wave (a wave made only of light enemies is unchanged). Total threat stays the same.
const LIGHT_LATE_PEAK := 270.0
const LIGHT_LATE_WEIGHT := {"swarmling": 0.35, "dart": 0.6, "drone": 0.6}

var _rx: RegEx
var _enemies := {}


func _init() -> void:
	_rx = RegEx.new()
	_rx.compile(r"^(\w+)(?:\*(\d+))?(?::([\d.]+))?@([\d.]+)(?:\+([\d.]+))?(?:~([\d.]+))?(?:#(-?\d+))?(.*)$")
	var c: CampaignDef = load("res://data/campaign.tres")
	var out := PackedStringArray()
	out.append("## GENERATED by tools/gen_waves.gd from tools/level_plan.gd -- edit the plan, not this file")
	out.append("## (or edit counts here by hand and stop regenerating). Exactly what spawns, no runtime rules.")
	out.append("## Group: enemy*count@interval[+start_delay][~count_variance][#route][!hp=x][!ph=n][!dmg=n]")
	out.append("##")
	out.append("## Enemy threat (Drone = 1):")
	var ids: Array = []
	for f in DirAccess.get_files_at("res://data/enemies"):
		if f.ends_with(".tres"):
			ids.append(f.get_basename())
	ids.sort()
	var row := "##  "
	for id in ids:
		row += " %s %.2f," % [id, DifficultyModel.enemy_threat(_enemy(id))]
		if row.length() > 100:
			out.append(row)
			row = "##  "
	if row.length() > 4:
		out.append(row)
	out.append("## Earliest wave per enemy (tools/level_plan.gd FIRST_WAVE): %s" % str(LP.FIRST_WAVE))
	out.append("")
	out.append("const WAVES := {")
	var grand := 0
	for li in range(c.levels.size()):
		var l: LevelDef = c.levels[li]
		var key := String(l.id)
		if not LP.PLAN.has(key):
			push_error("no plan for " + key)
			continue
		var peak := DifficultyModel.level_peak_threat(l.level_number)
		out.append("\t\"%s\": [ # %s  (peak %d)" % [key, l.display_name, int(peak)])
		var lines: Array = LP.PLAN[key]
		for wi in range(lines.size()):
			var parsed := _plan_wave(String(lines[wi]), wi)
			var w: WaveDef = parsed[0]
			var weights: Dictionary = parsed[1]
			var threat: float = parsed[2]
			var target := threat / 100.0 * peak
			var fixed := 0.0
			var wsum := 0.0
			if peak >= LIGHT_LATE_PEAK and weights.size() > 1:
				for g in weights.keys():
					weights[g] = float(weights[g]) * float(LIGHT_LATE_WEIGHT.get(String(g.enemy.id), 1.0))
			for g in w.groups:
				if weights.has(g):
					wsum += float(weights[g])
				else:
					fixed += g.count * DifficultyModel.enemy_threat(g.enemy, g.hp_multiplier)
			var rest := maxf(target - fixed, 0.0)
			for g in w.groups:
				if weights.has(g):
					var share: float = rest * weights[g] / maxf(wsum, 0.001)
					g.count = maxi(1, int(round(share / DifficultyModel.enemy_threat(g.enemy, g.hp_multiplier))))
			_spread(w)
			var cnt := 0
			var drones := 0.0
			for g in w.groups:
				cnt += g.count
				drones += g.count * DifficultyModel.enemy_threat(g.enemy, g.hp_multiplier)
			grand += cnt
			out.append("\t\t\"%s\", # w%d: %d enemies, threat %.0f (%d%% of peak)" % [_line(w), wi + 1, cnt, drones, int(threat)])
		out.append("\t],")
	out.append("}")
	var f := FileAccess.open("res://tools/level_waves.gd", FileAccess.WRITE)
	f.store_string("\n".join(out) + "\n")
	f.close()
	print("gen_waves: %d levels, %d enemies -> tools/level_waves.gd" % [c.levels.size(), grand])
	quit()


func _enemy(id: String) -> EnemyDef:
	if not _enemies.has(id):
		_enemies[id] = load("res://data/enemies/%s.tres" % id)
	return _enemies[id]


## [WaveDef, {group: weight} for budgeted groups, threat]
## Enemies placed before their LP.FIRST_WAVE (2026-11-21, user) become Drones there, same threat budget
## (budgeted counts are re-derived, fixed counts scaled by the threat ratio).
const EARLY_STANDIN := "drone"


func _plan_wave(line: String, wave_index: int = 99) -> Array:
	var parts := line.split("|")
	var w := WaveDef.new()
	var threat := 100.0
	if parts.size() > 1:
		for f in parts[1].split(","):
			var flag := f.strip_edges()
			if flag.is_valid_float(): threat = float(flag)
			elif flag == "special": w.is_special = true
			elif flag == "boss": w.is_boss = true
			elif flag == "night": w.night = true
			elif flag.begins_with("route="): w.active_route = int(flag.substr(6))
			elif flag.begins_with("prep="): w.prep_time_override = float(flag.substr(5))
			elif flag != "": push_error("unknown wave flag: " + flag)
	var weights := {}
	var groups: Array[SpawnGroupDef] = []
	for gs in parts[0].split(","):
		var m := _rx.search(gs.strip_edges())
		if m == null:
			push_error("bad group: " + gs)
			continue
		var g := SpawnGroupDef.new()
		g.enemy = _enemy(m.get_string(1))
		var fixed := int(m.get_string(2)) if m.get_string(2) != "" else -1
		var pace := 1.0
		if wave_index + 1 < int(LP.FIRST_WAVE.get(m.get_string(1), 1)):
			var standin := _enemy(EARLY_STANDIN)
			if fixed > 0: # fixed count: keep the same threat
				fixed = maxi(1, int(round(fixed * DifficultyModel.enemy_threat(g.enemy) / DifficultyModel.enemy_threat(standin))))
			pace = DifficultyModel.enemy_threat(standin) / DifficultyModel.enemy_threat(g.enemy) # same threat/second
			g.enemy = standin
		if fixed >= 0:
			g.count = fixed
		else:
			weights[g] = float(m.get_string(3)) if m.get_string(3) != "" else 1.0
		g.interval = float(m.get_string(4)) if pace >= 1.0 else maxf(0.5, float(m.get_string(4)) * pace)
		if m.get_string(5) != "": g.start_delay = float(m.get_string(5))
		if m.get_string(6) != "": g.count_variance = float(m.get_string(6))
		if m.get_string(7) != "": g.route_index = int(m.get_string(7))
		for opt in m.get_string(8).split("!", false):
			var kv := opt.split("=")
			match kv[0]:
				"hp": g.hp_multiplier = float(kv[1])
				"ph": g.max_boss_phases = int(kv[1])
				"dmg": g.base_damage_override = int(kv[1])
		groups.append(g)
	w.groups = groups
	return [w, weights, threat]


## Stretch spawn timing (never counts) until no 25 s window spawns more than CROWD_CAP.
func _spread(w: WaveDef) -> void:
	for _i in range(8):
		var peak := DifficultyModel.wave_peak(w)
		if peak <= CROWD_CAP:
			return
		var stretch := float(peak) / CROWD_CAP
		for g in w.groups:
			if not g.enemy.is_boss:
				g.interval *= stretch
				g.start_delay *= stretch


func _num(x: float) -> String:
	return str(snappedf(x, 0.01))


func _line(w: WaveDef) -> String:
	var gs := PackedStringArray()
	for g in w.groups:
		var s := "%s*%d@%s" % [g.enemy.id, g.count, _num(g.interval)]
		if g.start_delay > 0.0: s += "+" + _num(g.start_delay)
		s += "~" + _num(g.count_variance)
		if g.route_index != 0: s += "#%d" % g.route_index
		if absf(g.hp_multiplier - 1.0) > 0.0001: s += "!hp=" + _num(g.hp_multiplier)
		if g.max_boss_phases != 3: s += "!ph=%d" % g.max_boss_phases
		if g.base_damage_override >= 0: s += "!dmg=%d" % g.base_damage_override
		gs.append(s)
	var flags := PackedStringArray()
	if w.is_boss: flags.append("boss")
	if w.is_special: flags.append("special")
	if w.night: flags.append("night")
	if w.active_route >= 0: flags.append("route=%d" % w.active_route)
	if w.prep_time_override >= 0.0: flags.append("prep=" + _num(w.prep_time_override))
	var line := ", ".join(gs)
	if not flags.is_empty():
		line += " | " + ", ".join(flags)
	return line
