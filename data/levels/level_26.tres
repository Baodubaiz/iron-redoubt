[resource]
script = ExtResource("16_6nvqi")
id = &"level_26"
display_name = "10 — Dynamo"
level_number = 10
map = ExtResource("15_sems1")
waves = Array[ExtResource("18_ced63")]([SubResource("Resource_4mya6"), SubResource("Resource_a3vtw"), SubResource("Resource_witr6"), SubResource("Resource_vwybx"), SubResource("Resource_y2uaf"), SubResource("Resource_vnw0s"), SubResource("Resource_oy4od"), SubResource("Resource_jjrfp"), SubResource("Resource_17jm0"), SubResource("Resource_pback"), SubResource("Resource_7b2mt"), SubResource("Resource_rnxn5"), SubResource("Resource_8sjl3"), SubResource("Resource_g1t13"), SubResource("Resource_8ucx5"), SubResource("Resource_olxn5")])
starting_currency = 500
base_hp = 25
available_towers = Array[ExtResource("1_hnfve")]([ExtResource("2_e52d0"), ExtResource("3_xw1h0"), ExtResource("4_rihde"), ExtResource("5_1f5ov"), ExtResource("6_r25rv"), ExtResource("7_rirrm"), ExtResource("8_ncgvs"), ExtResource("9_1jp87"), ExtResource("10_7rgrb"), ExtResource("11_i4a81"), ExtResource("12_ud87d"), ExtResource("13_ho5ny")])
economy = ExtResource("14_ab4dx")
